<?xml version="1.0"?>
<launch>
    <!--carte à charger-->
    <arg name="map" />

    <arg name="map_file" default="/home/ubuntu/ros_ws/src/map/$(arg map).yaml"/>


    <!-- démarrer le paquet map server et publier la carte -->
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" >
        <param name="frame_id" value="map" />
    </node>
</launch>
